# 大模型 API 配置 —— 复制本文件为 .env 并填入你的真实 key
# DeepSeek 示例：https://platform.deepseek.com 注册后创建 API Key

LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
# 可选：deepseek-v4-flash（快/便宜，推荐）| deepseek-v4-pro（更强）
LLM_MODEL=deepseek-v4-flash

# ---- Embedding（向量化）配置 —— 阿里云百炼（通义千问）----
# 注册地址：https://bailian.console.aliyun.com → 创建 API Key
# 注意：这里要用阿里云的 key，不是 DeepSeek 的 key
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
# 如果拿到的是"专属 API Host"（形如 xxx.cn-beijing.maas.aliyuncs.com），
# 填你自己的 OpenAI 兼容地址；否则用公共地址（下面这行）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# embedding 模型名（标准为 text-embedding-v3，如有 v4 以平台为准）
EMBEDDING_MODEL=text-embedding-v3
